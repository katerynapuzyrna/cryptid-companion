/* =========================
   Search field & player inputs (QLineEdit)
   ========================= */

QLineEdit {
    background: #ffffff;
    border: 1px solid #d6dde2;
    border-radius: 12px;
    padding: 4px 12px;
    min-height: 30px;
    color: #182022;
}

QLineEdit#edtSelectSearch {
    padding-right: 36px;
    max-height: 30px;
}

QLineEdit#edtPlayer1,
QLineEdit#edtPlayer2,
QLineEdit#edtPlayer3,
QLineEdit#edtPlayer4,
QLineEdit#edtPlayer5,
QLineEdit#edtHotseatPlayer1,
QLineEdit#edtHotseatPlayer2,
QLineEdit#edtHotseatPlayer3,
QLineEdit#edtHotseatPlayer4,
QLineEdit#edtHotseatPlayer5,
QLineEdit#edtHotseatSpecificMapName {
    max-height: 30px;
}

QLineEdit:hover {
    border-color: #2f7d77;
}

QLineEdit:focus {
    border-color: #2f7d77;
}

QLineEdit::placeholder {
    color: #6b7580;
}
