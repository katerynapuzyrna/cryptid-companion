/* =========================
   Base / Global
   ========================= */

QWidget#centralwidget {
    background: #f2f4f6;
    border: none;
    color: #182022;
    font-family: "Segoe UI";
    font-size: 10.5pt;
}

QWidget {
    background: transparent;
    border: none;
    color: #182022;
    font-family: "Segoe UI";
    font-size: 10.5pt;
}

QLabel {
    color: #182022;
    background: transparent;
}


QLabel[title="true"] {
    background: transparent;
    color: #182022;
    font-size: 14pt;
    font-weight: 600;
    padding: 3px 2px 5px 2px;
}

QLabel#pageBreadcrumb {
    color: #5a6a72;
    font-size: 10pt;
    /* Space above crumb (title row, page top, or map-source segment above). */
    padding: 12px 2px 8px 2px;
}

QTextBrowser {
    background: transparent;
    border: none;
    color: #182022;
}

QFrame#toast {
    background: #d8ecea;
    color: #182022;
    border: 1px solid #b9d9d6;
    border-radius: 8px;
    font-family: "Segoe UI";
    font-size: 10.5pt;
    padding: 8px 12px;
}

QFrame#toast QToolButton {
    background: transparent;
    border: 2px solid transparent;
    border-radius: 6px;
    padding: 2px;
    color: #182022;
}

QFrame#toast QToolButton:hover {
    background: rgba(255, 255, 255, 0.4);
}

QFrame#toast QToolButton:checked {
    background: #ffffff;
    border: 2px solid #2f7d77;
}

/* Global scrollbar thickness = 10 */
QScrollBar:vertical {
    width: 10px;
    min-width: 10px;
    max-width: 10px;
}
QScrollBar:horizontal {
    height: 10px;
    min-height: 10px;
    max-height: 10px;
}


