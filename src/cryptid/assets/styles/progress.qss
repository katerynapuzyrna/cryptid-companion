/* =========================
   Indeterminate progress bar
   ========================= */

QProgressBar {
    background: #eef2f4;
    border: 1px solid #dde5ea;
    border-radius: 6px;
    min-height: 8px;
    max-height: 12px;
    text-align: center;
}

QProgressBar::chunk {
    background: #2f7d77;
    border-radius: 4px;
    min-width: 24px;
}
